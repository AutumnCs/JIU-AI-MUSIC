{
	
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jiu-bird-collection",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-07-30",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "jiu-music-db",
			"database_id": "89848116-339f-4b1b-aa3e-19d0ae018a41",
			"migrations_dir": "migrations"
		}
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"r2_buckets": [
		{
			"binding": "MUSIC_BUCKET",
			"bucket_name": "jiu-music-audio"
		},
		{
			"bucket_name": "jiu-music-audio",
			"binding": "jiu_music_audio",
			"remote": true
		}
	],
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "jiu-bird-collection"
		}
	],
	"vars": {
		"ASSISTANT_PROVIDER": "openai-compatible",
		"ASSISTANT_BASE_URL": "https://api.deepseek.com",
		"ASSISTANT_MODEL": "deepseek-v4-flash"
	},
	"placement": {
		"mode": "smart"
	},

	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
		"enabled": true,
		"head_sampling_rate": 1,
		"persist": true,
		"invocation_logs": true
		},
		"traces": {
		"enabled": false,
		"persist": true,
		"head_sampling_rate": 1
		}
	}
}
